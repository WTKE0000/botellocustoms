<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="makers-mark" style="width:52px;height:52px;margin-bottom:1rem">
          <svg viewBox="0 0 100 100" width="52" height="52">
            <circle class="ring" cx="50" cy="50" r="46"/>
            <circle class="ring-inner" cx="50" cy="50" r="38"/>
            <text x="50" y="47" font-size="26" text-anchor="middle" font-weight="700">CB</text>
            <text x="50" y="63" font-size="7.5" text-anchor="middle" letter-spacing="1.5">CUSTOMS</text>
          </svg>
        </div>
        <p style="max-width:32ch">A family firearms &amp; engraving business, three generations in the making. <%= settings.locationLine %>.</p>
      </div>
      <div>
        <h4>Shop</h4>
        <a href="/firearms">Firearms</a>
        <a href="/custom-work">Custom Work</a>
        <a href="/accessories">Accessories</a>
        <a href="/raffle">Raffle</a>
      </div>
<%
  const footerSnapUrl = settings.snapchatUrl || ('https://www.snapchat.com/add/' + settings.snapchatHandle);
%>
      <div>
        <h4>Business</h4>
        <a href="/about">Our Story</a>
        <a href="mailto:<%= settings.email %>">Email Us</a>
        <a href="<%= footerSnapUrl %>" target="_blank" rel="noopener">Snapchat: @<%= settings.snapchatHandle %></a>
      </div>
      <div>
        <h4>Visit</h4>
        <p><%= settings.address %></p>
        <p><%= settings.email %></p>
        <p>Snapchat: @<%= settings.snapchatHandle %></p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <%= new Date().getFullYear() %> <%= settings.businessName %>. All rights reserved.</span>
      <span>Firearm sales subject to federal &amp; Tennessee law · FFL transfer required</span>
    </div>
  </div>
</footer>

<script>
  window.SNAPCHAT_HANDLE = <%- JSON.stringify(settings.snapchatHandle || '') %>;
  window.SNAPCHAT_URL = <%- JSON.stringify(settings.snapchatUrl || (settings.snapchatHandle ? 'https://www.snapchat.com/add/' + settings.snapchatHandle : '')) %>;
</script>
<script src="/js/main.js"></script>
