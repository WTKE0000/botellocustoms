<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav', { active: '' }) %>

<section class="section" style="min-height:60vh;display:flex;align-items:center">
  <div class="container" style="max-width:420px">
    <span class="eyebrow">Join Us</span>
    <h1 style="margin-bottom:.4rem">Create an Account</h1>
    <p style="color:var(--ink-dim);margin-bottom:1.4rem">An account is required to redeem a raffle code and get your ticket number.</p>

    <% if (flash) { %>
      <div class="admin-flash <%= flash.type === 'error' ? 'error' : '' %>"><%= flash.message %></div>
    <% } %>

    <form action="/signup" method="POST">
      <input type="hidden" name="redirectTo" value="<%= redirectTo %>">
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" required autocomplete="email">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" minlength="6" required autocomplete="new-password">
        <p class="form-hint">At least 6 characters.</p>
      </div>
      <button type="submit" class="btn btn-brass btn-block">Create Account</button>
    </form>
    <p style="margin-top:1.4rem;font-size:.9rem;color:var(--ink-dim)">Already have an account? <a href="/login?redirect=<%= encodeURIComponent(redirectTo) %>" style="color:var(--brass)">Log in</a></p>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
