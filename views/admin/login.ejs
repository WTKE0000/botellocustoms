<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Login | Cesar Botello Customs</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
<div class="admin-login-shell">
  <div class="admin-login-card">
    <div style="text-align:center;margin-bottom:1.6rem">
      <div class="makers-mark" style="width:56px;height:56px;margin:0 auto 1rem">
        <svg viewBox="0 0 100 100" width="56" height="56">
          <circle class="ring" cx="50" cy="50" r="46"/>
          <circle class="ring-inner" cx="50" cy="50" r="38"/>
          <text x="50" y="47" font-size="26" text-anchor="middle" font-weight="700">CB</text>
          <text x="50" y="63" font-size="7.5" text-anchor="middle" letter-spacing="1.5">CUSTOMS</text>
        </svg>
      </div>
      <h1 style="font-size:1.4rem">Admin Dashboard</h1>
    </div>

    <% if (flash) { %>
      <div class="admin-flash <%= flash.type === 'error' ? 'error' : '' %>"><%= flash.message %></div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label for="username">Email</label>
        <input type="email" id="username" name="username" required autocomplete="username">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-brass btn-block">Log In</button>
    </form>
    <p class="form-hint" style="text-align:center;margin-top:1.4rem">Sign up as a customer first, then have your Supabase project mark that account as an admin (see README).</p>
  </div>
</div>
</body>
</html>
