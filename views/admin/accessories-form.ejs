<%- include('partials/shell-open', { pageTitle: item ? 'Edit Accessory' : 'Add Accessory', active: 'accessories', flash: flash }) %>

<div class="admin-header"><h1><%= item ? 'Edit' : 'Add' %> Accessory</h1></div>

<form action="<%= item ? '/admin/accessories/' + item.id : '/admin/accessories' %>" method="POST" enctype="multipart/form-data">
  <div class="admin-card">
    <div class="form-row">
      <div class="form-group">
        <label>Name</label>
        <input type="text" name="name" value="<%= item ? item.name : '' %>" required>
      </div>
      <div class="form-group">
        <label>Price (e.g. $89)</label>
        <input type="text" name="price" value="<%= item ? item.price : '' %>" required>
      </div>
    </div>
    <div class="form-group">
      <label>Description</label>
      <textarea name="description" required><%= item ? item.description : '' %></textarea>
    </div>
    <div class="form-group">
      <label>Photo</label>
      <% if (item && item.image) { %>
        <img src="<%= item.image %>" class="admin-thumb" style="width:100px;height:100px;margin-bottom:.6rem">
      <% } %>
      <input type="file" name="image" accept="image/*">
    </div>
  </div>
  <button type="submit" class="btn btn-brass">Save</button>
  <a href="/admin/accessories" class="btn btn-outline">Cancel</a>
</form>

<%- include('partials/shell-close') %>
