<%- include('partials/shell-open', { pageTitle: 'Accessories', active: 'accessories', flash: flash }) %>

<div class="admin-header">
  <h1>Accessories</h1>
  <a href="/admin/accessories/new" class="btn btn-brass btn-sm">+ Add Accessory</a>
</div>

<div class="admin-card">
  <table class="admin-table">
    <thead><tr><th>Photo</th><th>Name</th><th>Price</th><th></th></tr></thead>
    <tbody>
      <% accessories.forEach(function(item) { %>
        <tr>
          <td>
            <% if (item.image) { %>
              <img src="<%= item.image %>" class="admin-thumb">
            <% } else { %>
              <div class="admin-thumb-empty">—</div>
            <% } %>
          </td>
          <td><%= item.name %></td>
          <td><%= item.price %></td>
          <td class="actions">
            <a href="/admin/accessories/<%= item.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
            <form action="/admin/accessories/<%= item.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this accessory?')">
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (accessories.length === 0) { %>
        <tr><td colspan="4" style="color:var(--parchment-dim)">No accessories yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/shell-close') %>
